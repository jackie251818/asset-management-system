{
  "name": "asset-management-system",
  "version": "2.4.5",
  "description": "电脑资产管理系统 - 便携式离线版",
  "main": "main.js",
  "author": "Asset Management",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "node scripts/build-portable.js",
    "build:portable": "node scripts/build-portable.js --portable",
    "build:nsis": "node scripts/build-portable.js --nsis",
    "build:dir": "node scripts/build-portable.js --dir",
    "pack": "electron-builder --win portable --dir",
    "test": "node tests/smoke.test.js",
    "smoke": "node tests/smoke.test.js"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.local.asset-management",
    "productName": "固定资产管理系统",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "index.html",
      "styles.css",
      "asset_label_print.html",
      "final_chart_fix.js",
      "build-info.json",
      "js/**/*",
      "libs/**/*",
      "data/**/*",
      "!data/*.json",
      "!**/*.{md,d.ts,ts,map}",
      "!**/.{git,idea,vscode}/**",
      "!scripts/**",
      "!tests/**",
      "!_*.js",
      "!*.ps1",
      "!*.bat"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "electronLanguages": ["zh-CN", "en-US"],
      "compression": "maximum"
    },
    "portable": {
      "artifactName": "固定资产管理系统-便携版-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "固定资产管理系统-安装版-${version}.exe"
    }
  }
}
